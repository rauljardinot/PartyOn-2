<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_app_visibility" model="ir.ui.view">
        <field name="name">res.partner.form.app.visibility</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="App Visibility" name="app_visibility">
                    <field name="visible_menu_ids" widget="many2many_tags"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
