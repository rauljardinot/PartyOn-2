<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_app_visibility_list" model="ir.ui.view">
        <field name="name">ica.app.visibility.list</field>
        <field name="model">ica.app.visibility</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_populate_apps" type="object"
                            string="Populate Apps" class="btn-primary"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="menu_xmlid"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_app_visibility_form" model="ir.ui.view">
        <field name="name">ica.app.visibility.form</field>
        <field name="model">ica.app.visibility</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="menu_xmlid"/>
                        <field name="name"/>
                        <field name="group_ids" widget="many2many_tags"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_app_visibility_search" model="ir.ui.view">
        <field name="name">ica.app.visibility.search</field>
        <field name="model">ica.app.visibility</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="menu_xmlid"/>
                <field name="group_ids"/>
                <filter name="with_groups" string="Has Groups"
                        domain="[('group_ids', '!=', False)]"/>
                <filter name="without_groups" string="Visible To All"
                        domain="[('group_ids', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_app_visibility" model="ir.actions.act_window">
        <field name="name">App Visibility</field>
        <field name="res_model">ica.app.visibility</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_app_visibility_search"/>
    </record>
</odoo>
