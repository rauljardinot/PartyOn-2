            <xpath expr="//field[@name='uom_id']" position="after">
                <label for="margin_percentage" string="Margen (%)" invisible="not company_id.calculate_margin_button"/>
                <field name="margin_percentage" class="w-auto me-2" style="max-width: 50px;"
                       invisible="not company_id.calculate_margin_button"/>
                <button name="action_apply_margin"
                        class="btn-secondary ms-2"
                        type="object"
                        string="Añadir"
                        confirm="¿Está seguro de que quiere aplicar el margen?"
                        invisible="not company_id.calculate_margin_button"
                />
            </xpath>

            <xpath expr="//field[@name='uom_id']" position="attributes">
                <attribute name="style">max-width:60px</attribute>
            </xpath>

            <xpath expr="//field[@name='list_price']" position="attributes">
                <attribute name="style">max-width:80px</attribute>
            </xpath>

        </field>
    </record>
