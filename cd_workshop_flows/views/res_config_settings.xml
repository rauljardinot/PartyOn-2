<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="cd_worksop_flows_settings_form" model="ir.ui.view">
            <field name="name">cd.worksop.flows.settings.form</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//app[@name='stock']/block[@name='operations_setting_container']" position="before">
                    <block title="Extras del Flujo" name="custom_addons_setting">
                        <setting id="add_margin_button" title="Aplica el % de margen de forma manual" help="Activa o desactiva la opción manual del margen">
                                <field name="calculate_margin_button" required="1"/>
                        </setting>
                    </block>
                </xpath>

            </field>
        </record>

    </data>
</odoo>