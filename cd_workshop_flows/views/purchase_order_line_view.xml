<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Form View to Modify it -->
        <record id="cd_workshop_flows_purchase_order_line_form" model="ir.ui.view">
            <field name="name">cd.workshop.flows.purchase.order.line.form</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="before">
                    <field name="board_number"/>
                    <field name="board_format_id"/>
                    <field name="board_format_conversion" invisible="True" column_invisible="True"/>
                </xpath>

                <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="before">
                    <field name="total_price_sale"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>