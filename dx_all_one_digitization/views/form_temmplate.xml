<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_format_template_tree" model="ir.ui.view">
        <field name="name">format.template.tree</field>
        <field name="model">format.template</field>
        <field name="arch" type="xml">
            <tree string="Format Templates">
                <field name="name"/>
                <field name="prompt"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_format_template_form" model="ir.ui.view">
        <field name="name">format.template.form</field>
        <field name="model">format.template</field>
        <field name="arch" type="xml">
            <form string="Format Template">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="prompt"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action to open tree view -->
    <record id="action_format_template" model="ir.actions.act_window">
        <field name="name">Format Templates</field>
        <field name="res_model">format.template</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first format template
            </p>
        </field>
    </record>
</odoo>
