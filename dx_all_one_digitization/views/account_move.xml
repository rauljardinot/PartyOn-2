<odoo>
    <data>
        <!-- Action to open digitization wizard for CUSTOMER INVOICES -->
        <record id="action_digitalize_customer_invoice_wizard" model="ir.actions.act_window">
            <field name="name">Digitalize Customer Invoice</field>
            <field name="res_model">invoice.digitalize</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_invoice_digitalize_form"/>
            <field name="target">new</field>
            <field name="context">{'default_move_type': 'out_invoice'}</field>
        </record>

        <!-- Action to open digitization wizard for VENDOR BILLS -->
        <record id="action_digitalize_vendor_bill_wizard" model="ir.actions.act_window">
            <field name="name">Digitalize Vendor Bill</field>
            <field name="res_model">invoice.digitalize</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_invoice_digitalize_form"/>
            <field name="target">new</field>
            <field name="context">{'default_move_type': 'in_invoice'}</field>
        </record>

        <!-- Form view button -->
        <record model="ir.ui.view" id="view_account_move_form_inherit">
            <field name="name">account.move.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                   <xpath expr="//button[@name='action_post']" position="after">
                         <button string="Digitize Invoice" type="object" class="oe_highlight" name="action_show_digitalize_wizard"/>
                    </xpath>
            </field>
        </record>

        <!-- Tree view button for CUSTOMER INVOICES -->
        <record model="ir.ui.view" id="view_customer_invoice_tree_inherit">
            <field name="name">account.move.customer.invoice.tree.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <header>
                        <button name="%(action_digitalize_customer_invoice_wizard)d" 
                                string="Digitalize Customer Invoice" 
                                type="action" 
                                class="btn-primary"
                                display="always"/>
                    </header>
                </xpath>
            </field>
        </record>

        <!-- Tree view button for VENDOR BILLS -->
        <record model="ir.ui.view" id="view_vendor_bill_tree_inherit">
            <field name="name">account.move.vendor.bill.tree.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <header>
                        <button name="%(action_digitalize_vendor_bill_wizard)d" 
                                string="Digitalize Vendor Bill" 
                                type="action" 
                                class="btn-primary"
                                display="always"/>
                    </header>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
