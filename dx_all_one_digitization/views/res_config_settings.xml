<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_provider_config_settings" model="ir.ui.view">
        <field name="name">ai.provider.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app name="dx_all_one_digitization" string="AI Integration">
                    <block title="AI Provider Configuration">
                        <setting id="ai_provider_setting">
                            <field name="ai_provider"/>
                            <div class="content-group" invisible="ai_provider == 'odoo_ai'">
                                <div class="row mt16">
                                    <label for="api_key" string="API Key" class="col-lg-3 o_light_label"/>
                                    <field name="api_key" password="True" placeholder="Enter your API key"/>
                                </div>
                            </div>
                            <div class="content-group" invisible="ai_provider == 'odoo_ai'">
                                <div class="row mt16">
                                    <label for="model_name" string="Model Name" class="col-lg-3 o_light_label"/>
                                    <field name="model_name" placeholder="Optional: specific model name"/>
                                </div>
                            </div>
                            <div class="content-group mt16" invisible="ai_provider == 'odoo_ai'">
                                <div class="alert alert-info" role="alert">
                                    <i class="fa fa-info-circle"/> Make sure to use a valid API key. Requests to external providers may incur charges depending on the provider.
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
