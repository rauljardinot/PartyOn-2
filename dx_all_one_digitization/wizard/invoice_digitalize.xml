<!-- views/invoice_digitalize.xml -->
<odoo>
    <data>
        <record id="view_invoice_digitalize_form" model="ir.ui.view">
            <field name="name">invoice.digitalize.form</field>
            <field name="model">invoice.digitalize</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="file" widget="binary" filename="filename"/>
                         <field name="filename" invisible="1"/>
                        <field name="create_partner"/>
                        <field name="create_product"/>
                        <field name="currency_id"/>
                        <field name="match_product"/>
                    </group>
                    <footer>
                        <button string="Accept" type="object" class="oe_highlight" name="action_accept"/>
                        <button string="Cancel" class="oe_link" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_invoice_digitalize" model="ir.actions.act_window">
            <field name="name">Digitize Invoice</field>
            <field name="res_model">invoice.digitalize</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_invoice_digitalize_form"/>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
