<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="dx_all_one_digitization.BillsHiddenUploadForm">
        <div class="d-none o_vendor_bill_dxupload">
            <t t-call="HiddenInputFile">
                <t t-set="multi_upload" t-value="true"/>
                <t t-set="fileupload_id" t-value="widget.fileUploadID"/>
                <t t-set="fileupload_action" t-translation="off">/web/binary/upload_attachment</t>
                <input type="hidden" name="model" value=""/>
                <input type="hidden" name="id" value="0"/>
            </t>
        </div>
    </t>

    <t t-extend="ListView.buttons" t-name="DXBillsListView.buttons">
        <t t-jquery="button.o_list_button_add" t-operation="after">
            <button type="button" class="btn btn-secondary o_button_dxupload_bill">
                Upload to Digitalization
            </button>
        </t>
    </t>
</templates>