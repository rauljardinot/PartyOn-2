<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_partyon_estimate" model="ir.actions.report">
        <field name="name">Presupuesto para cliente</field>
        <field name="model">partyon.estimate</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">partyon_presupuestacion.report_partyon_estimate</field>
        <field name="report_file">partyon_presupuestacion.report_partyon_estimate</field>
        <field name="print_report_name">'Presupuesto - %s' % object.name</field>
        <field name="binding_model_id" ref="model_partyon_estimate"/>
        <field name="binding_type">report</field>
    </record>

    <template id="partyon_estimate_external_layout"
              inherit_id="web.external_layout_standard"
              primary="True">
        <xpath expr="//img[contains(@class, 'o_company_logo_small')]" position="attributes">
            <attribute name="class" add="partyon_estimate_company_logo" separator=" "/>
        </xpath>
        <xpath expr="//div[@name='company_address']" position="after">
            <div class="col-6 text-end" name="customer_address">
                <t t-out="address"/>
            </div>
        </xpath>
        <xpath expr="//t[@t-call='web.address_layout']" position="replace">
            <div class="oe_structure"/>
        </xpath>
        <xpath expr="//h2[@t-out='layout_document_title']" position="attributes">
            <attribute name="class" add="partyon_estimate_document_title" separator=" "/>
        </xpath>
    </template>

    <template id="report_partyon_estimate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc"/>
                <t t-set="company" t-value="doc.company_id"/>
                <t t-call="partyon_presupuestacion.partyon_estimate_external_layout">
                    <t t-set="address">
                        <div t-field="doc.partner_id"
                             t-options="{'widget': 'contact', 'fields': ['name', 'address'], 'no_marker': True}"/>
                    </t>
                    <t t-set="layout_document_title">
                        <span>Presupuesto </span>
                        <span t-field="doc.name"/>
                    </t>
                    <div class="page">
                        <div class="row mt-3 mb-4">
                            <div class="col-5 ms-auto">
                                <div><strong>Fecha:</strong> <span t-field="doc.date"/></div>
                                <div t-if="doc.date_validity"><strong>Válido hasta:</strong> <span t-field="doc.date_validity"/></div>
                            </div>
                        </div>
                        <p t-if="doc.description" t-field="doc.description"/>
                        <table class="table table-sm o_main_table mt-4">
                            <thead>
                                <tr>
                                    <th>Descripción</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-end">Precio</th>
                                    <th t-if="doc.quote_detail_mode == 'detail'" class="text-end">Impuestos</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="doc.quote_detail_mode == 'detail'">
                                    <tr t-foreach="doc.line_ids" t-as="line">
                                        <td><span t-field="line.name"/></td>
                                        <td class="text-end"><span t-field="line.quantity"/> <span t-field="line.uom_id"/></td>
                                        <td class="text-end"><span t-field="line.sale_subtotal" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                        <td class="text-end"><span t-field="line.tax_ids"/></td>
                                        <td class="text-end"><span t-field="line.sale_total" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                    </tr>
                                </t>
                                <tr t-else="">
                                    <td><span t-field="doc.estimate_name"/></td>
                                    <td class="text-end">1</td>
                                    <td class="text-end"><span t-field="doc.sale_price" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                    <td class="text-end"><span t-field="doc.sale_total" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="row justify-content-end">
                            <div class="col-5">
                                <table class="table table-sm">
                                    <tr>
                                        <td>Base imponible</td>
                                        <td class="text-end"><span t-field="doc.sale_price" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                    </tr>
                                    <tr t-foreach="doc.get_tax_summary()" t-as="tax">
                                        <td><span t-out="tax['name']"/></td>
                                        <td class="text-end"><span t-out="tax['amount']" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Total</strong></td>
                                        <td class="text-end"><strong t-field="doc.sale_total" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        <div t-if="doc.notes_customer" class="mt-4">
                            <strong>Condiciones y observaciones</strong>
                            <p t-field="doc.notes_customer"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
