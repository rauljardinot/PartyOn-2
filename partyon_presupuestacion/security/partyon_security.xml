<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_partyon" model="ir.module.category">
        <field name="name">PartyOn</field>
        <field name="description">Módulos de gestión PartyOn</field>
        <field name="sequence">100</field>
    </record>
        <record id="res_groups_privilege_partyon" model="res.groups.privilege">
        <field name="name">Presupuestación PartyOn</field>
        <field name="sequence">100</field>
        <field name="category_id" ref="module_category_partyon"/>
    </record>
    <record id="group_partyon_user" model="res.groups">
        <field name="name">Usuario de presupuestación</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_partyon"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="group_partyon_manager" model="res.groups">
        <field name="name">Responsable de presupuestación</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_partyon"/>
        <field name="implied_ids" eval="[Command.link(ref('group_partyon_user'))]"/>
    </record>
    <record id="partyon_estimate_comp_rule" model="ir.rule">
        <field name="name">Presupuestos por compañía</field>
        <field name="model_id" ref="model_partyon_estimate"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="partyon_estimate_line_comp_rule" model="ir.rule">
        <field name="name">Líneas de presupuesto por compañía</field>
        <field name="model_id" ref="model_partyon_estimate_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="partyon_estimate_template_comp_rule" model="ir.rule">
        <field name="name">Plantillas por compañía</field>
        <field name="model_id" ref="model_partyon_estimate_template"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="partyon_estimate_template_line_comp_rule" model="ir.rule">
        <field name="name">Líneas de plantilla por compañía</field>
        <field name="model_id" ref="model_partyon_estimate_template_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
