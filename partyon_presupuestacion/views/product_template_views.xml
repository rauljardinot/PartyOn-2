<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="party_on_product_template_form_presupuestacion" model="ir.ui.view">
        <field name="name">party.on.product.template.form.presupuestacion</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="need_machine_cost"/>
                <field name="estimate_id" invisible="1"/>
            </xpath>

            <xpath expr="//page[@name='inventory']" position="after">
                <page string="Líneas de presupuesto" invisible='not estimate_id'>
                    <field colspan="2" name="estimate_notes" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>