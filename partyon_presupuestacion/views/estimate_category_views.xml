<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="partyon_presupuestacion_estimate_category_form" model="ir.ui.view">
            <field name="name">partyon.presupuestacion.estimate.category.form</field>
            <field name="model">estimate.category</field>
            <field name="arch" type="xml">
                <form string="Formulario Categoría de presupuesto">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="partyon_presupuestacion_estimate_category_list" model="ir.ui.view">
            <field name="name">partyon.presupuestacion.estimate.category.list</field>
            <field name="model">estimate.category</field>
            <field name="arch" type="xml">
                <list string="Categorías de presupuesto">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="partyon_presupuestacion_estimate_category_action" model="ir.actions.act_window">
            <field name="name">partyon.presupuestacion.estimate.category.action</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">estimate.category</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>