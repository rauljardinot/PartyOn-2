<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="partyon_menu_root"
              name="Presupuestación"
              web_icon="partyon_presupuestacion,static/description/icon.png"
              sequence="25"/>

    <menuitem id="partyon_menu_estimates"
              name="Presupuestos"
              parent="partyon_menu_root"
              sequence="10"/>

    <menuitem id="partyon_menu_estimate_list"
              name="Presupuestos internos"
              parent="partyon_menu_estimates"
              action="partyon_estimate_action"
              sequence="10"/>

    <menuitem id="partyon_menu_config"
              name="Configuración"
              parent="partyon_menu_root"
              sequence="90"/>

    <record id="partyon_presupuestacion_settings_action" model="ir.actions.act_window">
        <field name="name">Ajustes</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'partyon_presupuestacion'}</field>
    </record>

    <menuitem id="partyon_menu_config_settings"
              name="Ajustes"
              parent="partyon_menu_config"
              action="partyon_presupuestacion_settings_action"
              groups="base.group_system"
              sequence="20"/>

    <menuitem id="partyon_menu_config_estimate_categ"
              name="Categorías"
              parent="partyon_menu_config"
              action="partyon_presupuestacion_estimate_category_action"
              sequence="10"/>

    <menuitem id="partyon_menu_estimates_templates"
              name="Plantillas"
              parent="partyon_menu_root"
              sequence="10"/>

    <menuitem id="partyon_menu_estimates_templates_list"
              name="Plantillas de Presupuesto"
              parent="partyon_menu_estimates_templates"
              action="partyon_estimate_template_action"
              sequence="10"/>

</odoo>
