<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partyon_estimate_template_list" model="ir.ui.view">
        <field name="name">partyon.estimate.template.list</field>
        <field name="model">partyon.estimate.template</field>
        <field name="arch" type="xml">
            <list string="Plantillas de presupuesto">
                <field name="name"/><field name="category_id"/><field name="margin_type"/><field name="quote_detail_mode"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="partyon_estimate_template_form" model="ir.ui.view">
        <field name="name">partyon.estimate.template.form</field>
        <field name="model">partyon.estimate.template</field>
        <field name="arch" type="xml">
            <form string="Plantilla de presupuesto">
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="category_id"/><field name="description"/></group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="margin_type"/>
                            <field name="margin_value" invisible="margin_type == 'manual'"/>
                            <field name="manual_sale_price" invisible="margin_type != 'manual'"/>
                            <field name="quote_detail_mode"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="line_type"/><field name="product_id"/><field name="name"/>
                            <field name="calculation_method"/>
                            <field name="manual_quantity" invisible="calculation_method != 'manual'"/>
                            <field name="pieces" optional="hide" invisible="calculation_method == 'manual'"/>
                            <field name="width" optional="hide" invisible="calculation_method not in ('area', 'volume')"/>
                            <field name="height" optional="hide" invisible="calculation_method not in ('area', 'volume')"/>
                            <field name="depth" optional="hide" invisible="calculation_method != 'volume'"/>
                            <field name="hours" optional="hide" invisible="calculation_method != 'hours'"/>
                            <field name="waste_percent" optional="hide" invisible="calculation_method not in ('area', 'volume')"/>
                            <field name="quantity" readonly="1"/><field name="uom_id"/>
                            <field name="cost_unit"/><field name="cost_subtotal" sum="Coste"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="partyon_estimate_template_action" model="ir.actions.act_window">
        <field name="name">Plantillas de presupuesto</field>
        <field name="res_model">partyon.estimate.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Cree una plantilla reutilizable</p></field>
    </record>
</odoo>
