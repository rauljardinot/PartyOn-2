<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partyon_estimate_template_line_form" model="ir.ui.view">
        <field name="name">partyon.estimate.template.line.form</field>
        <field name="model">partyon.estimate.template.line</field>
        <field name="arch" type="xml">
            <form string="Línea de plantilla">
                <sheet>
                    <group>
                        <group string="Recurso">
                            <field name="line_type"/>
                            <field name="product_id"/>
                            <field name="name" force_save="1"/>
                        </group>
                        <group string="Cálculo">
                            <field name="calculation_method" readonly="product_id" force_save="1"/>
                            <field name="manual_quantity" invisible="calculation_method != 'manual'"/>
                            <field name="time_unit_sel" invisible="calculation_method != 'hours'"/>
                            <field name="hours" invisible="calculation_method != 'hours'"/>
                            <field name="pieces" invisible="calculation_method not in ('area', 'volume', 'hours')"/>

                            <separator invisible="not product_id or not need_machine_cost"/>
                            <field name="machine_time_total" invisible="not product_id or not need_machine_cost"/>
                            <field name="machine_product_type" invisible="not product_id or not need_machine_cost"/>
                            <field name="need_machine_cost" invisible="1"/>
                        </group>
                    </group>
                    <group string="Medidas" invisible="calculation_method not in ('area', 'volume', 'length')">
                        <group>
                            <field name="dimension_uom_id"
                                   domain="[('name', 'in', ['cm', 'm'])]"
                                   options="{'no_create': True}"
                                   help="Unidad de medida de los valores que se calculan"
                            />
                            <field name="width" invisible="calculation_method not in ('area','volume')"/>
                            <field name="height"/>
                            <field name="depth" invisible="calculation_method != 'volume'"/>
                        </group>
                        <group>
                            <field name="waste_percent"/>
                        </group>
                    </group>
                    <group string="Resultado">
                        <group>
                            <field name="quantity" readonly="1"/>
                            <field name="uom_id" readonly="product_id" force_save="1"/>
                        </group>
                        <group>
                            <field name="cost_unit" widget="monetary" force_save="1"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="cost_subtotal" readonly="1"/>
                        </group>
                    </group>
                    <field name="currency_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="partyon_estimate_template_list" model="ir.ui.view">
        <field name="name">partyon.estimate.template.list</field>
        <field name="model">partyon.estimate.template</field>
        <field name="arch" type="xml">
            <list string="Plantillas de presupuesto">
                <field name="name"/><field name="category_id"/><field name="margin_type"/><field name="quote_detail_mode"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="partyon_estimate_template_form" model="ir.ui.view">
        <field name="name">partyon.estimate.template.form</field>
        <field name="model">partyon.estimate.template</field>
        <field name="arch" type="xml">
            <form string="Plantilla de presupuesto">
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="category_id"/><field name="description"/></group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="margin_type"/>
                            <field name="margin_value" invisible="margin_type == 'manual'"/>
                            <field name="manual_sale_price" invisible="margin_type != 'manual'"/>
                            <field name="quote_detail_mode"/>
                        </group>
                    </group>
                    <field name="line_ids"
                           mode="list"
                           context="{'form_view_ref': 'partyon_presupuestacion.partyon_estimate_template_line_form', 'dialog_size': 'large'}">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="product_id"/>
                            <field name="name" optional="hide"/>
                            <field name="width" string="Ancho"/>
                            <field name="height" string="Largo"/>
                            <field name="pieces"/>
                            <field name="quantity" readonly="1"/>
                            <field name="uom_id" readonly="1"/>
                            <field name="cost_subtotal" sum="Coste"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="partyon_estimate_template_action" model="ir.actions.act_window">
        <field name="name">Plantillas de presupuesto</field>
        <field name="res_model">partyon.estimate.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Cree una plantilla reutilizable</p></field>
    </record>
</odoo>
