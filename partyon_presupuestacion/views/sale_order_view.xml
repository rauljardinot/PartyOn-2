<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inherit Form View to Modify it -->
        <record id="partyon_estimate_sale_order_form" model="ir.ui.view">
            <field name="name">partyon.estimate.sale.order.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='payment_term_id']" position="after">
                    <field name="only_estimate_name" help="Selecciona esta opción si no quieres mandar todo el desglose de las lineas al cliente"/>
                </xpath>

                <xpath expr="//notebook/page[@name='order_lines']" position="after">
                    <page name="partyon_sale_lines" string="Lineas de cliente">
                        <field name="partyon_sale_line_ids">
                            <list>
                                <field name="name"/>
                                <field name="product_id"/>
                                <field name="price"/>
                                <field name="cost"/>
                                <field name="sale_order_id" invisible="1"/>
                                <field name="currency_id" invisible="1"/>
                            </list>
                        </field>

                    </page>
                </xpath>


            </field>
        </record>
    </data>
</odoo>