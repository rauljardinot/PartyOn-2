<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="partyon_estimate_sale_order_form" model="ir.ui.view">
            <field name="name">partyon.estimate.sale.order.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='payment_term_id']" position="after">
                    <field name="only_estimate_name" help="Selecciona esta opción si no quieres mandar todo el desglose de las lineas al cliente"/>
                </xpath>

                <xpath expr="//notebook/page[@name='order_lines']" position="after">
                    <page name="partyon_sale_lines" string="Lineas de cliente">
                        <field name="partyon_sale_line_ids">
                            <list>
                                <field name="product_name"/>
<!--                                <field name="price"/>-->
<!--                                <field name="cost"/>-->
                                <field name="line_total"/>
                                <field name="taxes_id" widget="many2many_tags"/>
                                <field name="product_amount"/>
                                <field name="unit_price"/>
                                <field name="sale_order_id" column_invisible="True" invisible="True"/>
                                <field name="currency_id" column_invisible="True"  invisible="True"/>
                            </list>
                        </field>

                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>