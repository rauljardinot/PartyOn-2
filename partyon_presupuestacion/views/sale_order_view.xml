<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partyon_estimate_sale_order_form" model="ir.ui.view">
        <field name="name">partyon.estimate.sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="partyon_estimate_id" invisible="not partyon_estimate_id"/>
            </xpath>
        </field>
    </record>
</odoo>
